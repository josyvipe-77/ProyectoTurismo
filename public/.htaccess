# Serve React routes on Hostinger while preserving real files and directories.
DirectoryIndex index.html
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^(?:assets|images|maps|materiales|research|licenses)(?:/|$) - [L]
  RewriteRule ^ index.html [L]
</IfModule>
